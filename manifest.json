{
    "manifest_version": 2,
    "name": "Zot-NASA-ADS",
    "version": "0.5.0",
    "description": "Updates paper metadata, downloads PDFs, and retrieves citation and reference information from NASA ADS.",
    "author": "Samuel Yee",
    "applications": {
      "zotero": {
        "id": "zot-nasa-ads@zot.nasa.ads",
        "homepage_url": "https://github.com/samuelyeewl/zot-nasa-ads",
        "update_url": "https://github.com/samuelyeewl/zot-nasa-ads/blob/main/updates.json",
        "strict_min_version": "6.999",
        "strict_max_version": "7.0.*"
      }
    }
  }